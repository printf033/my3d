material 
{
    name : "my3d",
    shadingModel : unlit,
    parameters : [
        { type : sampler2d, name : diffuse },
        { type : sampler2d, name : normal },
        // { type : sampler2d, name : occlusion },
        // { type : sampler2d, name : roughness },
        // { type : sampler2d, name : metallic },
        // { type : sampler2d, name : aorm },
        { type : sampler2d, name : emissive },
        { type : float,     name : roughnessFactor },
        { type : float,     name : metallicFactor },
        { type : float4,    name : diffuseFactor }
    ],
    requires : [
        "uv0",
        "tangents"
    ],
}

fragment 
{
    void material(inout MaterialInputs material) 
    {
        prepareMaterial(material);

        vec4 diffuseMap = texture(materialParams_diffuse, getUV0());
        material.baseColor = diffuseMap * materialParams.diffuseFactor;

        vec3 normalMap = texture(materialParams_normal, getUV0()).xyz * 2.0 - 1.0;
        material.normal = normalize(getWorldTangentFrame() * normalMap);

        // vec4 aoMap = texture(materialParams_occlusion, getUV0());
        // material.ambientOcclusion = aoMap.r;

        // vec4 roughnessMap = texture(materialParams_roughness, getUV0());
        // material.roughness = roughnessMap.r * materialParams.roughnessFactor;

        // vec4 metallicMap = texture(materialParams_metallic, getUV0());
        // material.metallic = metallicMap.r * materialParams.metallicFactor;

        // vec4 aormMap = texture(materialParams_aorm, getUV0());
        // material.ambientOcclusion = aormMap.r;
        // material.roughness = aormMap.g * materialParams.roughnessFactor;
        // material.metallic  = aormMap.b * materialParams.metallicFactor;

        material.emissive = texture(materialParams_emissive, getUV0());
    }
}
